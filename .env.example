# Copy to .env and fill in. Vite only exposes vars prefixed with VITE_.
# Restart the dev server after changing this file.

# Formspree form ID — enables real form submissions on the contact page.
# Get one free at https://formspree.io (new form -> copy the ID from the
# endpoint URL https://formspree.io/f/XXXXXXXX). Leave blank and the form
# falls back to opening the visitor's mail client instead.
VITE_FORMSPREE_ID=

# Shown as the fallback contact address, and used for the mailto: fallback
# above. Leave blank to hide it.
VITE_CONTACT_EMAIL=
