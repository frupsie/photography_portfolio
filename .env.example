# Copy to .env and fill in. Vite only exposes vars prefixed with VITE_.
# Restart the dev server after changing this file.

# Web3Forms access key — REQUIRED for the contact form to deliver.
#
# Get one in ~30 seconds, no account needed:
#   1. https://web3forms.com
#   2. Enter ngziyu.co@gmail.com
#   3. The key arrives by email — paste it below
#
# Also add this in your host's environment variables (Netlify: Site settings ->
# Environment variables / Vercel: Settings -> Environment Variables) so
# production builds pick it up.
#
# Safe to expose in the bundle: the key is write-only and bound to your
# address, so it can only ever deliver to you.
VITE_WEB3FORMS_KEY=
