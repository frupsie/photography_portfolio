# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Original full-res photos — keep locally, website serves compressed versions from photos-web/
public/photos/**/*.jpg
public/photos/**/*.JPG
public/photos/**/*.jpeg
public/photos/**/*.JPEG
public/photos/**/*.png
public/photos/**/*.PNG
!public/photos/**/hero-web.jpg

# Photo importer inbox — raw drops + processed archive. Local only.
.exif-inbox/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local secrets — never commit
.env
.env.local

# Agent tooling — installed per machine, not part of the site.
# settings.json and launch.json stay tracked: they're small, project-level,
# and useful to anyone who clones this.
.claude/skills/
.claude/settings.local.json

# Impeccable live-server runtime artifact
.impeccable/live/
